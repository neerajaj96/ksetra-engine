{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KsetraSpec",
  "description": "Semantic ksetra specification. Every node carries provenance rule IDs (GAME OBJECT -> RULE -> ENTITY -> SOURCE).",
  "type": "object",
  "required": ["meta", "units", "prasada", "complex", "provenance_index"],
  "properties": {
    "meta": {"type": "object", "required": ["name", "deity", "facing", "version"],
      "properties": {"name": {"type": "string"}, "deity": {"type": "string"},
        "facing": {"enum": ["east", "west"]}, "version": {"type": "string"},
        "yoni": {"enum": ["dhvaja", "vrisha"]}}},
    "units": {"type": "object", "required": ["hasta_angula", "angula_m"],
      "properties": {"hasta_angula": {"type": "number"}, "angula_m": {"type": "number"}}},
    "prasada": {"type": "object", "required": ["plan", "tala", "uttara_hasta", "garbha_hasta", "levels", "provenance"],
      "properties": {
        "plan": {"enum": ["square", "rectangular", "circular", "apsidal"]},
        "tala": {"enum": [1, 2, 3]},
        "uttara_hasta": {"type": "number"},
        "garbha_hasta": {"type": "number"},
        "levels": {"type": "array", "items": {"type": "object",
          "required": ["id", "kind", "h_hasta", "provenance"],
          "properties": {"id": {"type": "string"}, "kind": {"type": "string"},
            "h_hasta": {"type": "number"}, "provenance": {"type": "array", "items": {"type": "string"}}}}},
        "provenance": {"type": "array", "items": {"type": "string"}}}},
    "complex": {"type": "object", "required": ["nodes"],
      "properties": {"nodes": {"type": "array", "items": {"type": "object",
        "required": ["id", "kind", "provenance"],
        "properties": {"id": {"type": "string"}, "kind": {"type": "string"},
          "rel": {"type": "object"}, "params": {"type": "object"},
          "provenance": {"type": "array", "items": {"type": "string"}}}}}}},
    "constraints": {"type": "array", "items": {"type": "object",
      "required": ["id", "check", "provenance"],
      "properties": {"id": {"type": "string"}, "check": {"type": "string"},
        "provenance": {"type": "array", "items": {"type": "string"}}}}},
    "provenance_index": {"type": "object",
      "description": "rule_id -> {work, patala, verse, layer}",
      "additionalProperties": {"type": "object"}}
  }
}
